# Required / Core
# Default used only when a request omits demo_mode (e.g. curl/manual API
# calls). The web app always sends demo_mode explicitly per request based
# on the user's Demo Mode toggle, so this value doesn't affect the UI.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# AI Configuration (Mistral AI)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Optional / currently disabled integrations
# LLAMA_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=snapshop
# LANGCHAIN_TRACING_V2=false
# DATABASE_URL=postgresql+psycopg2://snapshop:snapshop@localhost:5432/snapshop
